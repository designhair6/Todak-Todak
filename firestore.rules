rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared global helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidVoucherCodeId(id) {
      return id is string && id.size() >= 4 && id.size() <= 64 && id.matches('^[A-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isEmailVerified() && request.auth.token.email == 'designhair6@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isEmailVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Entity validation helpers
    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
             data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
             isValidId(data.uid) &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.email.size() >= 3 &&
             data.email.size() <= 200 &&
             data.email == request.auth.token.email &&
             data.createdAt is timestamp;
    }

    function isValidVoucher(data) {
      return data.keys().hasAll(['code', 'type', 'value', 'title', 'status', 'createdBy', 'createdAt']) &&
             data.keys().hasOnly(['code', 'type', 'value', 'title', 'orderNote', 'status', 'createdBy', 'createdAt', 'usedAt', 'redeemedBy']) &&
             isValidVoucherCodeId(data.code) &&
             data.type in ['subscription', 'trial_days'] &&
             data.value is number &&
             data.value >= 1 &&
             data.value <= 9999 &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 100 &&
             (!('orderNote' in data) || (data.orderNote is string && data.orderNote.size() <= 120)) &&
             data.status in ['unused', 'used'] &&
             isValidId(data.createdBy) &&
             data.createdAt is timestamp &&
             (!('usedAt' in data) || data.usedAt is timestamp) &&
             (!('redeemedBy' in data) || (data.redeemedBy is string && data.redeemedBy.size() >= 3 && data.redeemedBy.size() <= 64 && data.redeemedBy.matches('^[a-zA-Z0-9_\\-]+$')));
    }

    // Admins collection (RBAC registry)
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isEmailVerified() && (request.auth.uid == adminId || isBootstrappedAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(adminId)
        && isBootstrappedAdmin()
        && adminId == request.auth.uid
        && isValidAdminUser(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(adminId) && isBootstrappedAdmin();
    }

    // Single-use vouchers collection
    match /vouchers/{voucherId} {
      // Buyers can look up ONLY the exact code they entered; listing all codes is admin-only
      allow get: if isValidVoucherCodeId(voucherId);
      allow list: if isAdmin();

      // Only authenticated admins can issue new voucher codes
      allow create: if isValidVoucherCodeId(voucherId)
        && isAdmin()
        && isValidVoucher(incoming())
        && incoming().code == voucherId
        && incoming().createdBy == request.auth.uid
        && incoming().status == 'unused'
        && !('usedAt' in incoming())
        && !('redeemedBy' in incoming())
        && incoming().createdAt == request.time;

      // Buyers without login can atomically transition an 'unused' code to 'used' once (anti-reuse)
      // Admins can manage voucher state/details
      allow update: if isValidVoucherCodeId(voucherId)
        && isValidVoucher(incoming())
        && incoming().code == existing().code
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'title', 'orderNote', 'value', 'type', 'usedAt', 'redeemedBy'])) ||
          (
            existing().status == 'unused' &&
            incoming().status == 'used' &&
            'usedAt' in incoming() &&
            incoming().usedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'usedAt', 'redeemedBy'])
          )
        );

      allow delete: if isValidVoucherCodeId(voucherId) && isAdmin();
    }
  }
}
